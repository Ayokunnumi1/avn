{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infrastructure/docker/node.Dockerfile",
    "watchPatterns": ["apps/worker/**", "apps/api/**", "infrastructure/docker/**", "packages/**", "pnpm-lock.yaml"]
  },
  "deploy": { "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 10 }
}
