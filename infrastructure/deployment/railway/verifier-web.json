{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infrastructure/docker/web.Dockerfile",
    "watchPatterns": ["apps/verifier-web/**", "infrastructure/docker/**", "packages/**", "pnpm-lock.yaml"]
  },
  "deploy": { "healthcheckPath": "/sign-in", "healthcheckTimeout": 120, "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 5 }
}
