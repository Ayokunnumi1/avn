{
  "name": "@avn/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { "./jobs": "./src/jobs/index.ts", "./container": "./src/container.ts" },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
