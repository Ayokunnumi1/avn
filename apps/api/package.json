    "@avn/config": "workspace:*",
    "@avn/contracts": "workspace:*",
    "@avn/database": "workspace:*",
    "@avn/logger": "workspace:*",
    "@avn/maps": "workspace:*",
    "@avn/notifications": "workspace:*",
    "@avn/payments": "workspace:*",
    "@avn/reporting": "workspace:*",
    "@avn/shared-utils": "workspace:*",
    "@avn/storage": "workspace:*",
    "bullmq": "^5.63.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "multer": "^2.0.2",
    "pino-http": "^10.5.0",
    "rate-limiter-flexible": "^7.4.0",
    "sharp": "^0.34.4",
