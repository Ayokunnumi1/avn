{
  "name": "avn",
  "private": true,
  "description": "AVN — Digital Address Verification Network (B2B2C + B2C)",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @avn/api dev",
    "dev:worker": "pnpm --filter @avn/worker dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test --concurrency=1",
    "db:generate": "pnpm --filter @avn/database db:generate",
    "db:migrate": "pnpm --filter @avn/database db:migrate",
    "db:deploy": "pnpm --filter @avn/database db:deploy",
    "db:seed": "pnpm --filter @avn/database db:seed",
    "db:reset": "pnpm --filter @avn/database db:reset",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "turbo": "^2.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "sharp", "esbuild", "msgpackr-extract"]
  }
}
